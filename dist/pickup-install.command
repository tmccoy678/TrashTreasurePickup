#!/bin/bash
set -euo pipefail
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/pickup-install.XXXXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
