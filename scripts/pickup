#!/bin/bash
set -euo pipefail
scripts=$(cd "$(dirname "$0")" && pwd)
source "$scripts/pickup-env.sh"
command=${1:-config}
if [[ $# -gt 0 ]]; then shift; fi
case "$command" in
    registry) exec "$pickup_python" "$scripts/pickup_registry.py" "$@" ;;
    receipt) exec "$pickup_python" "$scripts/treasurepickup_receipt.py" "$@" ;;
    python) exec "$pickup_python" "$@" ;;
    git) exec "$pickup_git" "$@" ;;
    gitleaks) exec "$pickup_gitleaks" "$@" ;;
    config) exec "$pickup_python" -c 'import json,os; from pathlib import Path; print(json.dumps({"pickup_home":str(Path(os.environ["PICKUP_HOME"]).expanduser().resolve())}))' ;;
    *) echo 'Use: pickup {registry|receipt|python|git|gitleaks|config}' >&2; exit 2 ;;
esac
